build/
vertex3d
*.o
*.mod
*.swp

# runtime output: regenerated by ./vertex3d on every run, so ignored --
# except a small curated example dataset kept under version control so
# the matlab/ scripts have something to run against out of the box.
data/*
!data/example/
!data/example/**
videos/

# LaTeX build artifacts in docs/ -- keep the .tex source under version
# control, but not the compiled PDF or intermediate build files.
docs/*.pdf
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
