! =====================================================================
! para.in
! Input parameters for the 3D Vertex Model on a spherical shell.
! Read as a Fortran NAMELIST by mod_parameters.f90 (namelist /SIMPARAMS/).
!
! Geometry
! --------
! N_subdivision : geodesic subdivision level L of the base icosahedron.
!                 Number of cells (apical shell)      Ncell = 10*4^L + 2
!                 Number of vertex "columns"           Nvert = 20*4^L
!                 (each column carries one apical + one basal vertex)
!                 L=0 -> 12 cells (all pentagons, exact "buckyball" seed)
!                 L=1 -> 42 cells, L=2 -> 162, L=3 -> 642, L=4 -> 2562 ...
! R_apical      : radius of the outer (apical) shell surface
! R_basal       : radius of the inner (basal) shell surface. Must be < R_apical.
!                 The shell is HOLLOW: nothing is modelled at r < R_basal.
!
! Energy functional  E = Sum_cells [ (K_V/2)(V-V0)^2 + (K_A/2)(Aapi-A0)^2
!                                    + (K_P/2) Papi^2
!                                    + (K_A_bas/2)(Abas-A0_bas)^2 + (K_P_bas/2) Pbas^2 ]
!                      + Sum_edges  Lambda_line * S_lateral(edge)
! (V = cell volume, Aapi/Papi = apical face area/perimeter, Abas/Pbas =
!  basal face area/perimeter (exact mirror of the apical terms, built
!  from the basal shell instead), S_lateral = area of the lateral
!  cell-cell interface associated with an apical edge)
! -----------------------------------------------------------------------
! K_V, K_A, K_P, Lambda_line : energy moduli (see Force.f90 for derivation)
! K_A_bas, K_P_bas           : basal-face moduli, mirroring K_A, K_P.
!                              OPTIONAL: if omitted from this file, each
!                              defaults to its apical counterpart
!                              (K_A_bas=K_A, K_P_bas=K_P), i.e. the basal
!                              face behaves exactly like the apical one
!                              unless you deliberately set it differently.
! V0_scale, A0_scale         : target V0 = V0_scale * (initial cell volume)
!                              target A0 = A0_scale * (initial apical area)
!                              (=1 means the initial geodesic mesh is the
!                               unstrained reference shape)
! A0_bas_scale               : target A0_bas = A0_bas_scale * (initial
!                              basal area). OPTIONAL, defaults to A0_scale.
!
! Dynamics (overdamped Langevin,  zeta * dr/dt = -dE/dr + noise)
! ----------------------------------------------------------------
! zeta_friction : friction coefficient
! kBT           : thermal noise amplitude (0 = pure gradient descent)
! dt            : integration time step
! n_steps       : total number of time steps to run
! it_dumps      : dump a binary snapshot to data/ every it_dumps steps
!
! Topology (junctional rearrangements)
! -------------------------------------
! L_T1_threshold     : apical edges shorter than this trigger a T1 attempt
! A_T2_threshold     : triangular cells with apical area below this collapse (T2)
! it_topology_check  : how often (in steps) to scan for T1/T2 events
! division_enable    : switch cell division on/off
! it_division_check  : how often (in steps) to scan for divisions
! V_division_threshold : a cell divides when V > V_division_threshold * V0
!
! T4_enable : switch crowding-induced live-cell extrusion on/off. A cell
!             whose volume drops below V_extrusion_threshold * V0 is
!             progressively whittled down by one ordinary T1 flip of its
!             own shortest edge per it_topology_check tick (so its
!             neighbours merge faces around it, rather than the cell
!             collapsing to a point as in T2); once it reaches 3 sides it
!             is removed via the same do_T2 used by ordinary T2 events.
!             No separate cadence knob -- reuses it_topology_check.
! V_extrusion_threshold : a cell is crowded (extrusion-eligible) when
!             V_last < V_extrusion_threshold * V0.
! T4_direction_deadband : extrusion direction (apical-ward vs basal-ward)
!             is classified from the ACTUAL net resultant radial force on
!             the cell's own apical ring vs its own basal ring (summed
!             from f_api/f_bas, the real analytic forces, projected onto
!             each vertex's radial direction) at the moment of removal --
!             whichever ring's net force is more outward is the exit
!             direction. If the two nets' fractional difference is
!             smaller than this deadband, the event is counted as
!             direction-ambiguous rather than forced to either side.
!             OPTIONAL, defaults to 0.05.
!
! defect_enable : switch the defect-cell protocol on/off. When true, a
!             random subset of cells is seeded at t=0 (once, right
!             after the mesh is built and its usual targets are set)
!             with one or more mechanical differences from the rest of
!             the tissue (the three levers below), to try to reproduce
!             the real "apical extrusion of a transformed/abnormal
!             cell" phenomenon -- see mod_defect.f90 for the full story
!             (including which lever actually reproduces it). Purely
!             additive: with defect_enable=.false. nothing changes.
! defect_fraction : fraction (0,1] of the initial alive-cell population
!             to seed as defect cells, chosen uniformly at random.
! Lambda_line_defect : lever (1) -- this cell's own lateral-tension
!             modulus instead of Lambda_line. OPTIONAL, defaults to
!             Lambda_line (no adhesion difference). Confirmed to give
!             preferential removal but a mixed/basal-leaning exit
!             direction, NOT the real phenomenon's apical bias.
! defect_A0_bas_scale : lever (2), RECOMMENDED -- scales a defect
!             cell's own basal-area target by this extra factor
!             (representing loss of basal identity/polarity).
!             OPTIONAL, defaults to 1.0 (no change). Confirmed to give
!             both preferential removal AND a genuine apical-majority
!             exit direction (~60%) -- the lever that actually
!             reproduces the real phenomenon.
! defect_boundary_tension : lever (3) -- an extra lateral tension added
!             only on edges between a defect cell and a non-defect
!             neighbour (the literal "actomyosin purse-string"
!             mechanism). OPTIONAL, defaults to 0.0 (off). Confirmed to
!             behave like lever (1) in practice (basal-leaning), since
!             a sparsely-seeded defect cell's edges are almost all
!             already heterotypic.
!
! random_seed            : seed for the Langevin noise / any stochastic choices
! capacity_growth_factor : the cell/vertex arrays are pre-allocated at
!                          this factor times the initial cell/vertex
!                          count, to leave room for cell divisions to
!                          grow the tissue. Raise it if you see
!                          "capacity exceeded" warnings during a run
!                          with many divisions.
! =====================================================================
&SIMPARAMS
  N_subdivision         = 2
  R_apical              = 10.0d0
  R_basal               = 8.0d0

  K_V                   = 1.0d0
  K_A                   = 1.0d0
  K_P                   = 0.1d0
  Lambda_line           = 0.1d0
  K_A_bas               = 1.0d0
  K_P_bas               = 0.2d0
  V0_scale              = 1.0d0
  A0_scale              = 1.0d0
  A0_bas_scale          = 1.0d0

  zeta_friction         = 1.0d0
  kBT                   = 0.0d0
  dt                    = 1.0d-3
  n_steps               = 100000
  it_dumps              = 100

  L_T1_threshold        = 0.05d0
  A_T2_threshold        = 0.01d0
  it_topology_check     = 5
  division_enable       = .false.
  it_division_check     = 500
  V_division_threshold  = 1.4d0

  T4_enable             = .false.
  V_extrusion_threshold = 0.92d0
  T4_direction_deadband = 0.0d0

  defect_enable         = .false.
  defect_fraction       = 0.1d0
  Lambda_line_defect    = 1.0d0
  defect_A0_bas_scale   = 0.1d0

  random_seed            = 12345
  capacity_growth_factor = 3.0d0
/
